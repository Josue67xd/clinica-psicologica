rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function ownsExisting() { return signedIn() && resource.data.ownerId == request.auth.uid; }
    function ownsNew() { return signedIn() && request.resource.data.ownerId == request.auth.uid; }
    match /{collection}/{id} {
      allow create: if collection in ['services','patients','psychometrics'] && ownsNew();
      allow read, delete: if collection in ['services','patients','psychometrics'] && ownsExisting();
      allow update: if collection in ['services','patients','psychometrics'] && ownsExisting() && ownsNew();
    }
    match /{document=**} { allow read, write: if false; }
  }
}
